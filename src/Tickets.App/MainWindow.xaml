<Window x:Class="Tickets.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Tickets.App"
        Title="Билеты · 0.17.0" Icon="Assets/Tickets.ico" Width="1420" Height="880" MinWidth="800" MinHeight="500" WindowStartupLocation="CenterScreen" WindowState="Maximized" ResizeMode="CanResize" WindowStyle="SingleBorderWindow" ShowInTaskbar="True">
  <Window.Resources>
    <ControlTemplate x:Key="WorkspaceTabsTemplate042" TargetType="TabControl">
      <Grid KeyboardNavigation.TabNavigation="Local">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,40,0" Focusable="False">
          <StackPanel Orientation="Horizontal">
            <TabPanel IsItemsHost="True" Panel.ZIndex="1" KeyboardNavigation.TabIndex="1"/>
            <ContentPresenter Content="{TemplateBinding Tag}"/>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
        </Border>
      </Grid>
    </ControlTemplate>
    <Style x:Key="HallHeaderAction042" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="30"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="5"/><Setter Property="Margin" Value="4,0,0,0"/><Setter Property="ContentTemplate" Value="{x:Null}"/>
    </Style>
    <Style x:Key="HallTab042" TargetType="TabItem">
      <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabBorder" Background="#EEEEEE" BorderBrush="#CBD5E1" BorderThickness="1" Padding="{TemplateBinding Padding}">
          <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="White"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SeatActionStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="72"/><Setter Property="Height" Value="72"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="3"/>
      <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><TextBlock Text="{Binding}" MaxWidth="58" TextWrapping="Wrap" TextAlignment="Center"/></Viewbox></DataTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
  <DockPanel x:Name="MainContent">
    <Border DockPanel.Dock="Top" Background="#152C46" Padding="20,14">
      <DockPanel LastChildFill="True">
        <TextBlock x:Name="AppBrand" DockPanel.Dock="Left" Text="БИЛЕТЫ" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,20,0" VerticalAlignment="Center"/>
        <TextBox x:Name="SearchBox" DockPanel.Dock="Left" Width="230" Height="34" VerticalAlignment="Center" Margin="0,0,12,0" TextChanged="SearchChanged" ToolTip="Поиск по названию, площадке или дате"/>
        <WrapPanel HorizontalAlignment="Right">
          <Button Content="Настройки" Click="SettingsClick" Margin="0,3,6,3"/>
          <Button Content="Главная" Click="HomeClick" Margin="0,3,6,3"/>
          <Button Content="Закрыть" Click="CloseClick" Margin="0,3,0,3"/>
        </WrapPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="White" Padding="15,9" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0">
      <WrapPanel VerticalAlignment="Center">
        <TextBlock x:Name="StatusText" Text="Загрузка…" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Button x:Name="TicketlandConflictsButton033" Visibility="Collapsed" Click="TicketlandConflictsClick033" ContentTemplate="{x:Null}" Width="Auto" Height="Auto" MinHeight="0" Padding="5,0" Margin="6,0,0,0" FontSize="13" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
      </WrapPanel>
    </Border>
    <Grid x:Name="MainWorkspaceLayout" Margin="12,5,12,5"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border x:Name="WorkspaceNavigation" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top"><TextBlock Text="Мероприятия" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,8">
              <Button Content="Залы" Click="HallsClick"/><Button Content="Спектакли" Click="PerformancesClick"/>
              <Button Content="Получатели / организации" Click="RecipientsClick" Margin="0,5,0,0"/>
              <Button Content="Расценовки" Click="PricesClick" Margin="0,5,0,0"/>
              <Button Content="Бланки печати" Click="TicketBlanksClick" Margin="0,5,0,0"/><Button Content="Новый показ" Click="NewEventClick" Margin="0,5,0,0"/>
            </WrapPanel>

          </StackPanel>
          <TreeView x:Name="EventsList" SelectedItemChanged="EventChanged" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

        </DockPanel>
      </Border>
      <Grid x:Name="Workspace" ClipToBounds="True" Grid.Column="2" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="250" MinWidth="200" MaxWidth="500"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel x:Name="EventSummaryHeader" Margin="5,0,40,3"><ScrollViewer x:Name="EventHeaderScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal"><TextBlock x:Name="EventTitle" Text="Выберите мероприятие" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="EventDate" FontSize="19" Margin="10,3,0,0" FontWeight="Bold"/><TextBlock x:Name="EventVenue" FontSize="19" Foreground="#64748B" Margin="10,3,0,0"/></StackPanel></ScrollViewer>
          <TextBlock x:Name="EventSubtitle" FontSize="19" Foreground="#64748B" Margin="0,5,0,0" TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel>
        <TabControl x:Name="WorkspaceTabs" SelectionChanged="WorkspaceTabChanged" Grid.Row="1" BorderBrush="#CBD5E1" Background="White" Template="{StaticResource WorkspaceTabsTemplate042}">
          <TabControl.Tag>
            <StackPanel x:Name="SquareShowActions" Orientation="Horizontal" Margin="0">
              <Button x:Name="PrintTicketsButton" ToolTip="{Binding Text, ElementName=SelectionHint}" Style="{StaticResource HallHeaderAction042}" Content="Печать" Click="PrintTicketsClick" Background="#1B7A43" Foreground="White" IsEnabled="False"/>
              <Button x:Name="IssueButton" ToolTip="{Binding Text, ElementName=SelectionHint}" Style="{StaticResource HallHeaderAction042}" Content="Накладная" Click="IssueClick" Background="#2466A8" Foreground="White" IsEnabled="False"/>
            </StackPanel>
          </TabControl.Tag>
          <TabItem Style="{StaticResource HallTab042}" Header="Схема зала">
            <Grid>
              <DockPanel>
                <ScrollViewer DockPanel.Dock="Bottom" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                  <StackPanel Margin="0,5,0,4"><TextBlock x:Name="HallTotals" Margin="5,0,5,5" FontWeight="Bold" TextWrapping="NoWrap"/><WrapPanel x:Name="StatusLegendPanel" Margin="5,0"/></StackPanel>
                </ScrollViewer>
                <local:HallView x:Name="Hall" Margin="5,0"/>
              </DockPanel>

            </Grid>
          </TabItem>
          <TabItem x:Name="JournalTab" Style="{StaticResource HallTab042}" Header="Журнал выдачи и возвратов">
            <DockPanel Margin="10">
              <Grid x:Name="JournalHeader" DockPanel.Dock="Top" Height="44" Margin="0,0,0,6">
                <TextBlock x:Name="JournalInstructions" Text="Нажмите строку, чтобы открыть накладную. Для объединения отметьте несколько накладных." Foreground="#64748B" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" FontSize="18"/>
                <Grid x:Name="JournalMergeActions" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="MergeInvoicesButton" Width="Auto" Height="34" FontSize="14" Margin="0" VerticalAlignment="Center" Padding="10,2" Content="Объединить накладные" Visibility="Collapsed" HorizontalAlignment="Left" Click="MergeInvoicesClick"/><TextBlock x:Name="JournalSelectionStatus" Grid.Column="1" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>
              </Grid>
              <DataGrid x:Name="HistoryGrid" RowDetailsVisibilityMode="Collapsed" FontSize="18" ColumnHeaderHeight="30" GridLinesVisibility="All" HorizontalGridLinesBrush="#B8C2CE" VerticalGridLinesBrush="#B8C2CE" SelectionMode="Single" SelectionUnit="FullRow" PreviewMouseLeftButtonUp="HistoryRowClick">
                <DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGrid.Resources>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="" Width="38" CanUserSort="False"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <CheckBox Tag="{Binding Id}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="JournalChecked" Unchecked="JournalChecked" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Выбрать накладную для объединения"/>
                  </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="100"/>
                  <DataGridTextColumn Header="Выдача" Binding="{Binding Date}" Width="190" MinWidth="190"/>
                  <DataGridTextColumn Header="От" Binding="{Binding SenderKind}" Width="75" MinWidth="75"/>
                  <DataGridTextColumn Header="Получатель" Binding="{Binding Recipient}" Width="*" MinWidth="140"/>
                  <DataGridTextColumn Header="Билетов" Binding="{Binding Count}" Width="95"/>
                  <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Total, StringFormat=N0}" Width="130" MinWidth="130"/>
                  <DataGridTemplateColumn Header="Возврат" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Loaded="ReturnCountLoaded027"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="140" Visibility="Collapsed"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>
        </TabControl>
        <StackPanel Grid.RowSpan="2" Panel.ZIndex="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,4,0">
        <Button x:Name="RefreshTicketlandButton029" Width="32" Height="32" FontSize="24" ContentTemplate="{x:Null}" Padding="0" Content="↻" Margin="0,0,0,2" ToolTip="Обновить" AutomationProperties.Name="Обновить" Loaded="InitializeTicketlandUi029" Click="RefreshTicketlandClick029"/>
        <Button x:Name="ToggleHallButton038" Width="32" Height="32" Margin="0" Padding="3" ContentTemplate="{x:Null}" ToolTip="Раскрыть зал" AutomationProperties.Name="Раскрыть зал" Click="ToggleHallClick038">
          <Viewbox Width="24" Height="24"><Canvas Width="24" Height="24">
            <Path Fill="#00B428" Data="M2,2 L10,2 L10,5 L7,5 L12,10 L10,12 L5,7 L5,10 L2,10 Z"/>
            <Path Fill="#00B428" Data="M2,2 L10,2 L10,5 L7,5 L12,10 L10,12 L5,7 L5,10 L2,10 Z"><Path.RenderTransform><RotateTransform Angle="90" CenterX="12" CenterY="12"/></Path.RenderTransform></Path>
            <Path Fill="#00B428" Data="M2,2 L10,2 L10,5 L7,5 L12,10 L10,12 L5,7 L5,10 L2,10 Z"><Path.RenderTransform><RotateTransform Angle="180" CenterX="12" CenterY="12"/></Path.RenderTransform></Path>
            <Path Fill="#00B428" Data="M2,2 L10,2 L10,5 L7,5 L12,10 L10,12 L5,7 L5,10 L2,10 Z"><Path.RenderTransform><RotateTransform Angle="270" CenterX="12" CenterY="12"/></Path.RenderTransform></Path>
          </Canvas></Viewbox>
        </Button>
        </StackPanel>
        <GridSplitter Grid.Column="1" Grid.RowSpan="2" Width="6" HorizontalAlignment="Stretch" Background="#CBD5E1" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>
        <Border x:Name="SelectionSidebar" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="4" Margin="8,0,0,0">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,5">
              <TextBlock x:Name="SelectedSummary" Text="Ничего не выбрано" FontSize="16.8" FontWeight="Bold" Foreground="#C1121F" Margin="0,0,0,3" TextWrapping="Wrap"/>
              <TextBlock Text="Получатель / организация" Margin="0,0,0,3"/>
              <ComboBox x:Name="RecipientBox" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" MinHeight="34" Padding="4" DropDownOpened="RecipientOpened" SelectionChanged="RecipientSelected"/>
              <TextBlock x:Name="IssuedRecipients" Visibility="Collapsed" Foreground="#9A3412" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="44" Margin="0,4,0,3"/>
            </StackPanel>
            <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="150" Margin="0,5,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="LegendPanel"/></ScrollViewer>
            <StackPanel x:Name="PriceEditorPanel" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,0,0,6">
              <TextBlock Text="Цена выбранных мест, ₽"/>
              <TextBox x:Name="PriceBox" TextChanged="PriceAmountChanged" KeyDown="PriceKeyDown"/>
              <ComboBox x:Name="PriceColorBox" MinHeight="32" Margin="0,4" ToolTip="Общий цвет цены"/>
              <Button Style="{StaticResource SeatActionStyle}" x:Name="ApplyPriceButton" Content="Применить цену" Click="ApplyPriceClick"/>
            </StackPanel>
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <ComboBox x:Name="SelectedViewBox" SelectedIndex="0" SelectionChanged="SelectedViewChanged" MinHeight="28" Padding="3" Margin="0,0,0,5"><ComboBoxItem Content="По местам"/><ComboBoxItem Content="Сводка по ценам"/></ComboBox>
              <ListBox x:Name="SelectedList" Grid.Row="1" BorderBrush="#E2E8F0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3,4"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="15.6" Foreground="{Binding AlertBrush}" FontWeight="Bold"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="14.3" Foreground="{Binding AlertBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <ListBox x:Name="SelectedPriceSummary" Padding="4" Grid.Row="1" Visibility="Collapsed" BorderBrush="#E2E8F0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="14.3" FontWeight="Bold" TextWrapping="Wrap" Margin="0,1"/></DataTemplate></ListBox.ItemTemplate></ListBox>
            </Grid>
          </DockPanel>
        </Border>
        <StackPanel Visibility="Collapsed">
          <ComboBox x:Name="SenderBox" SelectionChanged="SenderSelectionChanged025" LostKeyboardFocus="SenderFocusLost025" DropDownOpened="SenderDropDownOpened" PreviewMouseRightButtonUp="SenderContextRequested" IsEditable="True"/>
          <TextBox x:Name="SeriesBox" Text="ТЕСТ" MaxLength="32" TextChanged="SeriesChanged"/>
          <TextBox x:Name="NumberBox" Text="1" TextChanged="InputChanged"/>
          <Button x:Name="UndoPriceButton" IsEnabled="False"/>
          <Button x:Name="ExtendInvoiceButton" Content="Дополнить накладную" Click="ExtendInvoiceClick" IsEnabled="False"/>
          <Button x:Name="ReserveButton" Visibility="Collapsed" Content="Забронировать" Click="ReserveClick" IsEnabled="False"/>
          <Button x:Name="SaleStateButton" Content="Заблокировать" Click="SaleStateClick" IsEnabled="False"/>
          <Button x:Name="ReturnButton" Content="Вернуть выбранные" Click="ReturnClick" IsEnabled="False"/>
          <TextBlock x:Name="SelectionHint"/>
        </StackPanel>
      </Grid>
      <Border x:Name="HomePanel" Grid.Column="2" Background="White" Padding="35">
        <StackPanel VerticalAlignment="Center" MaxWidth="600" HorizontalAlignment="Center">
          <TextBlock Text="Билеты" FontSize="34" FontWeight="Bold" Foreground="#152C46"/>

          <TextBlock Text="Выберите мероприятие" FontSize="24" Margin="0,20,0,12"/>
          <TextBlock Text="Список мероприятий находится слева. Найдите спектакль по названию, площадке или дате и нажмите на него, чтобы открыть зал." TextWrapping="Wrap" FontSize="16" Foreground="#475569"/>
          <TextBlock x:Name="HomeSummary" Foreground="#64748B" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
  <Grid x:Name="DialogLayer" Panel.ZIndex="20" Visibility="Collapsed"/>
  </Grid>
</Window>
